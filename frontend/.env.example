# Leave blank for Vite's local /api proxy; set to the deployed API origin in production.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
# OSM standard tiles are best-effort. Replace with a provider you are authorized to use at scale.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
